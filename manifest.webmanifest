{
  "name": "Canadian Citizenship Quiz",
  "short_name": "Citizenship Quiz",
  "description": "Practice for the Canadian Citizenship Test.",
  "id": "/quizz.html",
  "start_url": "./quizz.html",
  "scope": "./",
  "display_override": [
    "standalone",
    "window-controls-overlay"
  ],
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#ffffff",
  "theme_color": "#d52b1e",
  "lang": "en",
  "icons": [
    {
      "src": "./assets/images/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./assets/images/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./assets/images/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "screenshots": [
    {
      "src": "./assets/screenshots/desktop.png",
      "sizes": "1280x720",
      "type": "image/png",
      "label": "Desktop Experience",
      "form_factor": "wide"
    },
    {
      "src": "./assets/screenshots/home-en.png",
      "sizes": "720x1280",
      "type": "image/png",
      "label": "Home Screen",
      "form_factor": "narrow"
    },
    {
      "src": "./assets/screenshots/quiz-question.png",
      "sizes": "720x1280",
      "type": "image/png",
      "label": "Quiz Question",
      "form_factor": "narrow"
    },
    {
      "src": "./assets/screenshots/quiz-correct-answer.png",
      "sizes": "720x1280",
      "type": "image/png",
      "label": "Correct Answer",
      "form_factor": "narrow"
    },
    {
      "src": "./assets/screenshots/results.png",
      "sizes": "720x1280",
      "type": "image/png",
      "label": "Results",
      "form_factor": "narrow"
    },
    {
      "src": "./assets/screenshots/statistics.png",
      "sizes": "720x1280",
      "type": "image/png",
      "label": "Statistics",
      "form_factor": "narrow"
    }
  ]
}